app publicApi {
  wasp: {
    version: "^0.17.1"
  },
  title: "public-api",
  head: [
    "<link rel='icon' href='/favicon.ico' />",
  ],
  server: {
    setupFn: import { serverSetup } from "@src/server/setup",
    middlewareConfigFn: import { serverMiddlewareFn } from "@src/server/setup"
  },
  auth: {
    userEntity: User,
    onAfterSignup: import { onAfterSignup } from "@src/auth/hooks",
    methods: {
      email: {
        fromField: {
          name: "Paleto Events",
          email: "noreply@paleto.local"
        },
        userSignupFields: import { userSignupFields } from "@src/auth/email/userSignupFields",
        emailVerification: {
          clientRoute: EmailVerificationRoute,
        },
        passwordReset: {
          clientRoute: PasswordResetRoute,
        }
      },
    },
    onAuthSucceededRedirectTo: "/",
    onAuthFailedRedirectTo: "/login",
  },
  emailSender: {
    provider: SMTP,
    defaultFrom: {
      name: "Paleto Events",
      email: "noreply@paleto.rs"
    },
  },
  client: {
    rootComponent: import { App } from "@src/App.tsx",
  }
}

// #region Auth
route LoginRoute { path: "/login", to: LoginPage }
page LoginPage {
  component: import { LoginPage } from "@src/auth/email/LoginPage.tsx"
}

route SignupRoute { path: "/signup", to: SignupPage }
page SignupPage {
  component: import { SignupPage } from "@src/auth/email/SignupPage.tsx"
}

route RequestPasswordResetRoute { path: "/request-password-reset", to: RequestPasswordResetPage }
page RequestPasswordResetPage {
  component: import { RequestPasswordResetPage } from "@src/auth/email/RequestPasswordResetPage.tsx",
}

route PasswordResetRoute { path: "/password-reset", to: PasswordResetPage }
page PasswordResetPage {
  component: import { PasswordResetPage } from "@src/auth/email/PasswordResetPage.tsx",
}

route EmailVerificationRoute { path: "/email-verification", to: EmailVerificationPage }
page EmailVerificationPage {
  component: import { EmailVerificationPage } from "@src/auth/email/EmailVerificationPage.tsx",
}

route NoAccessRoute { path: "/no-access", to: NoAccessPage }
page NoAccessPage {
  authRequired: true,
  component: import { NoAccessPage } from "@src/auth/NoAccessPage.tsx",
}
// #endregion Auth

// #region Dashboard
route DashboardRoute { path: "/", to: DashboardPage }
page DashboardPage {
  authRequired: true,
  component: import { DashboardPage } from "@src/dashboard/DashboardPage.tsx"
}

route RadionicaRoute { path: "/radionica/:id", to: EventDetailsPage }
page EventDetailsPage {
  authRequired: true,
  component: import { EventDetailsPage } from "@src/dashboard/EventDetailsPage.tsx"
}

query getMe {
  fn: import { getMe } from "@src/events/queries",
  entities: [User]
}

query getAdminEvents {
  fn: import { getAdminEvents } from "@src/events/queries",
  entities: [Event, Reservation]
}

query getAdminEventsForRange {
  fn: import { getAdminEventsForRange } from "@src/events/queriesCalendar",
  entities: [Event, User]
}

route WorkshopsCalendarRoute { path: "/kalendar", to: WorkshopsCalendarPage }
page WorkshopsCalendarPage {
  authRequired: true,
  component: import { WorkshopsCalendarPage } from "@src/dashboard/WorkshopsCalendarPage.tsx"
}

query getUploadedImages {
  fn: import { getUploadedImages } from "@src/events/queries",
  entities: [Event, User]
}

query getAdminEventById {
  fn: import { getAdminEventById } from "@src/events/queries",
  entities: [Event, User]
}

query getReservationsForEvent {
  fn: import { getReservationsForEvent } from "@src/reservations/queries",
  entities: [Reservation, User]
}

action deleteReservation {
  fn: import { deleteReservation } from "@src/reservations/actions",
  entities: [Reservation, User]
}

query getReservationsAdmin {
  fn: import { getReservationsAdmin } from "@src/reservations/queries",
  entities: [Reservation, Event, User]
}

query getReservationById {
  fn: import { getReservationById } from "@src/reservations/queries",
  entities: [Reservation, Event, User]
}

action confirmReservation {
  fn: import { confirmReservation } from "@src/reservations/actions",
  entities: [Reservation, Event, User]
}

action rejectReservation {
  fn: import { rejectReservation } from "@src/reservations/actions",
  entities: [Reservation, Event, User]
}

query getEmailBlacklist {
  fn: import { getEmailBlacklist } from "@src/reservations/emailBlacklist",
  entities: [User, EmailBlacklist]
}

action addEmailToBlacklist {
  fn: import { addEmailToBlacklist } from "@src/reservations/emailBlacklist",
  entities: [User, EmailBlacklist]
}

action removeEmailFromBlacklist {
  fn: import { removeEmailFromBlacklist } from "@src/reservations/emailBlacklist",
  entities: [User, EmailBlacklist]
}

route ReservationsRoute { path: "/rezervacije", to: ReservationsPage }
page ReservationsPage {
  authRequired: true,
  component: import { ReservationsPage } from "@src/reservations/ReservationsPage.tsx"
}

route ReservationDetailRoute { path: "/rezervacije/:id", to: ReservationDetailPage }
page ReservationDetailPage {
  authRequired: true,
  component: import { ReservationDetailPage } from "@src/reservations/ReservationDetailPage.tsx"
}

route EmailBlacklistRoute { path: "/rezervacije/blacklist", to: EmailBlacklistPage }
page EmailBlacklistPage {
  authRequired: true,
  component: import { EmailBlacklistPage } from "@src/reservations/EmailBlacklistPage.tsx"
}
// #endregion Dashboard

// #region Events
route EventsRoute { path: "/events", to: EventsPage }
page EventsPage {
  authRequired: true,
  component: import { EventsPage } from "@src/events/EventsPage.tsx"
}

action createEvent {
  fn: import { createEvent } from "@src/events/actions",
  entities: [Event, User]
}

action updateEvent {
  fn: import { updateEvent } from "@src/events/actions",
  entities: [Event, User]
}

action updateEventStatus {
  fn: import { updateEventStatus } from "@src/events/actions",
  entities: [Event, User]
}

action uploadEventImage {
  fn: import { uploadEventImage } from "@src/events/actions",
  entities: [Event, User]
}

action deleteEvent {
  fn: import { deleteEvent } from "@src/events/actions",
  entities: [Event, User]
}

api getEventsPublic {
  fn: import { getEventsPublic } from "@src/events/api",
  entities: [Event, Reservation],
  auth: false,
  httpRoute: (GET, "/api/events")
}

api getEventBySlugPublic {
  fn: import { getEventBySlugPublic } from "@src/events/apiSlug",
  entities: [Event, Reservation],
  auth: false,
  httpRoute: (GET, "/api/events/by-slug")
}

api createReservationPublic {
  fn: import { createReservationPublic } from "@src/reservations/api",
  entities: [Reservation, Event, EmailBlacklist],
  auth: false,
  httpRoute: (POST, "/api/reservations")
}

api createReservationsBulkPublic {
  fn: import { createReservationsBulkPublic } from "@src/reservations/apiBulk",
  entities: [Reservation, Event, EmailBlacklist],
  auth: false,
  httpRoute: (POST, "/api/reservations/bulk")
}
// #endregion Events
