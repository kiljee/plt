# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/database_name"

# CORS: dozvoljeni origini (zarezom za više). Prazno = http://localhost:3000
# Prod: npr. CORS_ORIGINS=https://tvoj-app.vercel.app,https://dashboard.example.com
# CORS_ORIGINS=

# Mailtrap (API token from https://mailtrap.io/api-tokens)
MAILTRAP_API_TOKEN=0fd45ba5ecb78f2077c8a2f99caa77c4

# MinIO (bucket kreiraš ručno u MinIO konzoli)
# Lokal: ENDPOINT=localhost, PORT=9000, USE_SSL=false. Prod: postavi na Railway MinIO host/port/ssl.
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=paleto-events
MINIO_USE_SSL=false